# Your Dwellir API key. Get one at https://www.dwellir.com
DWELLIR_API_KEY=

# Wallets to watch, comma separated
WALLETS=0xYourWallet1,0xYourWallet2

# Optional: builder addresses for builder-staking
# BUILDERS=0xBuilderAddress

# Optional endpoint overrides (defaults shown)
# HL_GRPC_ENDPOINT=api-hyperliquid-mainnet-grpc.n.dwellir.com:443
# HL_INFO_URL=https://api-hyperliquid-mainnet-info.n.dwellir.com/info
# HL_INDEX_URL=https://api-hyperliquid-index.n.dwellir.com/info
